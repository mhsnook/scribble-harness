{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // The React Compiler runs in the Vite build and skips any component it
    // cannot prove pure, without saying so. This is what says so: it reports the
    // Rules of React violations that cause a skip, so a component dropping out
    // of memoisation shows up here rather than as a slow Panel.
    "react/react-compiler": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  // Skills are installed from mhsnook/skills, so they are read here and never
  // edited here.
  "ignorePatterns": [
    ".claude/**",
    ".agents/**",
    "src/client/routeTree.gen.ts",
    "worker-configuration.d.ts"
  ],
  "overrides": [
    {
      "files": ["src/server/**", "test/**", "*.config.ts", ".storybook/**"],
      "env": { "browser": false, "node": true }
    },
    {
      // `this.sql` is a statement written as a tagged template, so a write
      // discards the rows it returns. Only the Agents SDK spells it that way.
      "files": ["src/server/**"],
      "rules": { "no-unused-expressions": ["error", { "allowTaggedTemplates": true }] }
    }
  ]
}
