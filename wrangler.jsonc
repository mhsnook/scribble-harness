{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribble",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-08-06",
  // The Agents SDK needs the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "scribble.msnook.xyz",
      "custom_domain": true,
    },
  ],
  // Deleting this takes the preview URLs with it: a route turns workers_dev off,
  // and preview_urls follows workers_dev.
  "preview_urls": true,
  // Static assets with single-page-application fallback, so a deep link like
  // /a/:id returns index.html. Worker paths need run_worker_first, or the
  // fallback swallows them before the Worker runs.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"],
  },
  // One Article Agent per Article. The Agents SDK needs SQLite-backed storage,
  // which is spelled new_sqlite_classes in the migration below.
  "durable_objects": {
    "bindings": [
      {
        "name": "ArticleAgent",
        "class_name": "ArticleAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArticleAgent"],
    },
  ],
  // The article index — architecture.md §9. Its schema lives in ./migrations;
  // `pnpm db:migrate` applies it locally and `db:migrate:remote` to the deploy.
  // database_id binds and database_name is a label, so the two can disagree —
  // deploy.md §The database name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scribble",
      "database_id": "cd4de478-744e-4871-91d7-22581fda569b",
      "migrations_dir": "./migrations",
    },
  ],
  // Inference runs on Cloudflare over this binding, and the model is named in
  // llm/model.ts and nowhere else. Workers Paid plan is required.
  //
  // Do not set "remote": true — it makes `pnpm dev` demand an API token before
  // it serves anything. See the remoteBindings note in vite.config.ts.
  "ai": {
    "binding": "AI",
  },
  // AI_GATEWAY_ID is deliberately not declared here. It names the account's AI
  // Gateway, which is deployment configuration rather than repo content, and a
  // var declared in this file overwrites the deployed value on every
  // `wrangler deploy` — so declaring it even as an empty placeholder would wipe
  // the one set from the CLI. Its type is in src/server/env.d.ts, and
  // llm/model.ts is the only thing that reads it.
  //
  // EXA_API_KEY is absent for the same reason, and is a secret rather than a
  // var: `wrangler secret put EXA_API_KEY`, or .dev.vars for `pnpm dev`. Unset
  // gives the Chat no search tool. llm/search.ts is the only reader.
  "observability": {
    "enabled": true,
  },
}
